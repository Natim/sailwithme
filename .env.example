DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_URL=postgis://sailswithme:sailswithme@localhost:5432/sailswithme
ALLOWED_HOSTS=localhost,127.0.0.1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional map tiles (https://carto.com/basemaps/apikey). If unset, OSM France tiles are used
# on the public maps and in the Django admin map (tile.openstreetmap.org blocks the admin widget).
# CARTO_API_KEY=

# Google OAuth. Redirect URI: http://localhost:8000/accounts/google/login/callback/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Facebook Login (App ID / App Secret). Redirect URI:
# http://localhost:8000/accounts/facebook/login/callback/
# Permissions: email, public_profile.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
